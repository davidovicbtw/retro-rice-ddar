/* DDAR Spotlight launcher for Rofi (>= 1.7).
 * One big search field in the upper third of the screen, results underneath.
 * Self-contained: colours are written in, nothing else is imported.
 *   rofi -show drun -theme /path/to/this/file.rasi
 * Source: templates/rofi/launcher-spotlight.rasi in the DDAR repository. */

configuration {
    show-icons:          true;
    drun-display-format: "{name}[  <span size='small' alpha='65%'>{generic}</span>]";
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
    sort:                true;
    sorting-method:      "fzf";
}

* {
    font:             "Noto Sans 10";
    background-color: transparent;
    text-color:       #e7e1cf;
    spacing:          0;
}

window {
    location:         north;
    anchor:           north;
    y-offset:         18%;
    width:            640px;
    background-color: #1f2024ff;
    border:           1px;
    border-color:     #1b1c20;
    border-radius:    14px;
    padding:          10px;
}

mainbox {
    spacing:          8px;
    children:         [ inputbar, listview ];
}

inputbar {
    spacing:          10px;
    padding:          6px 8px;
    children:         [ icon-search, entry ];
}
icon-search {
    expand:           false;
    filename:         "system-search";
    size:             26px;
    vertical-align:   0.5;
}
entry {
    font:             "Noto Sans 18";
    placeholder:      "Search";
    placeholder-color: #9d9787;
    vertical-align:   0.5;
    cursor:           text;
}


listview {
    lines:            7;
    columns:          1;
    fixed-height:     false;
    dynamic:          true;
    scrollbar:        false;
    spacing:          2px;
    border:           1px 0 0 0;
    border-color:     #1b1c20;
    padding:          8px 0 0 0;
}

element {
    padding:          7px 10px;
    spacing:          12px;
    border-radius:    9px;
    cursor:           pointer;
}
element normal.active, element alternate.active {
    text-color:       #d49a2a;
}
element selected.normal, element selected.active {
    background-color: #d49a2a;
    text-color:       #16161a;
}
element-icon {
    size:             28px;
    cursor:           inherit;
}
element-text {
    text-color:       inherit;
    vertical-align:   0.5;
    markup:           true;
    cursor:           inherit;
}
