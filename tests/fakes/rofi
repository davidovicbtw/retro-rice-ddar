#!/bin/bash
# Test double for rofi: logs arguments and input, answers with the next index from $ROFI_PICKS ("ESC" = cancel).
log="$FAKE_LOG"; { echo "=== rofi $*"; cat; } >> "$log"
[[ "$*" == *-password* ]] && { echo "secretpw"; exit 0; }
n=$(cat "$FAKE_STATE" 2>/dev/null || echo 0); echo $((n+1)) > "$FAKE_STATE"
read -r -a picks <<<"$ROFI_PICKS"; p="${picks[$n]:-ESC}"
[[ "$p" == ESC ]] && exit 1
[[ "$*" == *-password* ]] && { echo "secretpw"; exit 0; }
echo "$p"
