{
  "_comment": "DDAR Waybar module definitions. @SCRIPTS@ is replaced at generation time. Layout and visibility come from ~/.config/ddar/ddar.conf.",
  "modules": {
    "custom/ddar": {
      "format": "▚ DDAR",
      "tooltip-format": "DDAR menu",
      "on-click": "'@SCRIPTS@/ddar-popup' menu",
      "on-click-right": "'@SCRIPTS@/ddar-popup' launcher"
    },
    "hyprland/workspaces": {
      "format": "{name}",
      "on-click": "activate",
      "sort-by-number": true,
      "on-scroll-up": "hyprctl dispatch workspace e-1",
      "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
    "wlr/taskbar": {
      "format": "{icon} {title:.22}",
      "icon-size": 14,
      "tooltip-format": "{title}",
      "on-click": "activate",
      "on-click-middle": "close",
      "on-click-right": "minimize-raise"
    },
    "hyprland/window": {
      "format": "{title}",
      "max-length": 60,
      "separate-outputs": true
    },
    "mpris": {
      "format": "♪ {dynamic}",
      "format-paused": "‖ {dynamic}",
      "format-stopped": "",
      "dynamic-len": 28,
      "dynamic-order": ["artist", "title"],
      "dynamic-separator": " - ",
      "on-click": "'@SCRIPTS@/ddar-popup' media",
      "on-click-middle": "playerctl play-pause",
      "on-scroll-up": "playerctl next",
      "on-scroll-down": "playerctl previous"
    },
    "cpu": {
      "interval": 5,
      "format": "CPU {usage:>2}%",
      "states": { "warning": 70, "critical": 90 },
      "on-click": "'@SCRIPTS@/ddar-popup' system"
    },
    "memory": {
      "interval": 10,
      "format": "MEM {percentage:>2}%",
      "tooltip-format": "{used:0.1f} of {total:0.1f} GiB in use",
      "states": { "warning": 75, "critical": 90 },
      "on-click": "'@SCRIPTS@/ddar-popup' system"
    },
    "network": {
      "interval": 10,
      "format-wifi": "NET {signalStrength}%",
      "format-ethernet": "LAN",
      "format-linked": "LAN no IP",
      "format-disconnected": "NET off",
      "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname} {ipaddr}/{cidr}",
      "tooltip-format-ethernet": "{ifname} {ipaddr}/{cidr}",
      "tooltip-format-disconnected": "Disconnected",
      "on-click": "'@SCRIPTS@/ddar-popup' network"
    },
    "pulseaudio": {
      "format": "VOL {volume}%",
      "format-muted": "VOL mute",
      "format-bluetooth": "BT {volume}%",
      "format-bluetooth-muted": "BT mute",
      "scroll-step": 5,
      "max-volume": 150,
      "tooltip-format": "{desc}",
      "on-click": "'@SCRIPTS@/ddar-popup' audio",
      "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    "battery": {
      "interval": 30,
      "states": { "warning": 25, "critical": 10 },
      "format": "BAT {capacity}%",
      "format-charging": "CHG {capacity}%",
      "format-plugged": "AC {capacity}%",
      "tooltip-format": "{timeTo}",
      "on-click": "'@SCRIPTS@/ddar-popup' power"
    },
    "backlight": {
      "format": "LCD {percent}%",
      "on-scroll-up": "brightnessctl -q set +5%",
      "on-scroll-down": "brightnessctl -q set 5%-"
    },
    "tray": {
      "icon-size": 14,
      "spacing": 4
    },
    "clock": {
      "format": "{:%H:%M}",
      "tooltip-format": "<tt>{calendar}</tt>",
      "calendar": {
        "mode": "month",
        "format": { "today": "<b><u>{}</u></b>" }
      },
      "on-click": "'@SCRIPTS@/ddar-popup' calendar"
    },
    "custom/weather": {
      "exec": "'@SCRIPTS@/ddar-weather'",
      "return-type": "json",
      "interval": 1800,
      "signal": 8,
      "on-click": "'@SCRIPTS@/ddar-weather' --refresh && pkill -RTMIN+8 -x waybar"
    }
  }
}
